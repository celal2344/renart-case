{
    "version": 2,
    "builds": [
        {
            "src": "server/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "client/package.json",
            "use": "@vercel/next"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/server/index.js"
        },
        {
            "src": "/health",
            "dest": "/server/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "/client/$1"
        }
    ],
    "crons": [
        {
            "path": "/api/cron",
            "schedule": "15 2 * * *"
        }
    ]
}