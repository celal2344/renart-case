{
    "version": 2,
    "name": "renart-jewelry-api",
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/server.js"
        }
    ],
    "crons": [{
        "path": "/api/cron",
        "schedule": "0 */6 * * *"
    }],
    "env": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "API_PREFIX": "/api",
        "API_VERSION": "v1",
        "RATE_LIMIT_WINDOW_MS": "900000",
        "RATE_LIMIT_MAX_REQUESTS": "100",
        "SWISSQUOTE_API_URL": "https://forex-data-feed.swissquote.com/public-quotes/bboquotes/instrument/XAU/USD",
        "CORS_ORIGIN": "*",
        "SWAGGER_TITLE": "Jewelry Store API",
        "SWAGGER_DESCRIPTION": "API for managing jewelry products with real-time gold pricing",
        "SWAGGER_VERSION": "1.0.0"
    },
    "functions": {
        "server.js": {
            "maxDuration": 10
        }
    }
}